# Copy to .env.local and fill in real values. Never commit .env.local.

# Public site URL (used for auth redirects and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API Keys). Use the publishable key, not the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Used for demo seeding and curriculum seed scripts.
# Never expose it to the browser. Not needed until M2 demo mode.
SUPABASE_SECRET_KEY=

# Optional: comma-separated list of allowed sign-up email domains (e.g. bluefieldstate.edu)
AUTH_ALLOWED_EMAIL_DOMAINS=

# Show the /dev/ui kit page in production builds
NEXT_PUBLIC_ENABLE_UI_KIT=false
